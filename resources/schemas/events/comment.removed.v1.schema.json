{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.sbblog.dev/events/comment.removed.v1.schema.json",
    "title": "comment.removed (v1) payload",
    "description": "A public comment was hidden, rejected, marked as spam or deleted.",
    "type": "object",
