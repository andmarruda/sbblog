{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.sbblog.dev/events/integrations.updated.v1.schema.json",
    "title": "integrations.updated (v1) payload",
    "description": "The full list of enabled integrations of one scope. Replace the scope's list.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "scope",
        "author_profile_id",
        "article_id",
        "integrations"
    ],
    "properties": {
        "scope": {
            "enum": [
                "blog",
                "author",
                "article"
            ]
        },
        "author_profile_id": {
            "type": [
                "string",
                "null"
            ],
            "format": "uuid"
        },
        "article_id": {
            "type": [
                "string",
                "null"
            ],
            "format": "uuid"
        },
        "integrations": {
            "type": "array",
            "items": {
                "$ref": "https://schemas.sbblog.dev/events/common.schema.json#/$defs/integration"
            }
        }
    }
}
